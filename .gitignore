# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is meant to be committed: README step 6 says to copy it,
# and without it a fresh clone can't be set up. Verified to hold names only,
# every value empty. The broad .env* above was swallowing it.
!.env.local.example

# vercel
.vercel

# Firebase Hosting exists here for one reason: a custom auth domain
# (auth.elovox.app) requires Hosting to serve the reserved /__/auth/* paths.
# The site itself is on Vercel. `.firebaserc` and the `hosting` block in
# firebase.json are committed so the setup is reproducible, but these two are
# not: `firebase-hosting/` is the generated placeholder page nobody visits,
# and `.firebase/` is the local deploy cache.
/firebase-hosting/
/.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor/agent config
/.claude/

# Vendored third-party agent skills, pulled from docs.stripe.com (see the
# copies kept locally alongside skills-lock.json). Stripe's documentation,
# not ours — kept on disk for local tooling, never redistributed from this
# repo, which is public.
/.agents/
/.devin/
/.windsurf/
/skills-lock.json

# Internal operational runbook: live Price IDs, the webhook URL and its
# event list, env var names, console paths. None of it is a credential, but
# together it is a free map of the production setup — and it goes stale in
# ways that misdescribe the current security posture. Keep it local.
/STRIPE-GO-LIVE.md

# Capacitor / iOS.
# The Xcode project itself is committed; generated and fetched artefacts are
# not. ios/App/App/public is a build-time copy of native-shell/, and
# GoogleService-Info.plist carries the Firebase iOS config — keep it local
# rather than in a public repo.
/ios/App/App/public/
/ios/App/Pods/
/ios/App/**/GoogleService-Info.plist
/ios/DerivedData/
/ios/App/.build/

# App Store screenshot captures (scripts/appstore-screenshots.sh). Marketing
# artefacts, regenerated per release, and several MB each.
/screenshots/
